# =========================================================================
# AI STAFF OPERATIONS INTELLIGENCE PLATFORM - PRODUCTION ENVIRONMENT CONFIG
# =========================================================================

# 1. Database Connection (PostgreSQL 14+)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/staff_ops_db?schema=public"

# 2. Google Gemini AI Integration (Required for AI Copilot & Staff Assistant)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# 3. Security & HTTP Sessions
# REQUIRED in production: Cryptographically random secret string of at least 32 characters
SESSION_SECRET="change-this-to-a-secure-random-32-char-secret-in-production"

# 4. Networking & Hosting Configuration
# Base URL where frontend application is hosted (used for CORS and origin validation)
APP_URL="http://localhost:3000"

# Runtime Environment mode: 'development' | 'test' | 'production'
NODE_ENV="development"

# Server Port
PORT=5000
